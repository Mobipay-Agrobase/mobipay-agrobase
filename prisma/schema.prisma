  tenant        Tenant   @relation("TenantCommissionRules", fields: [tenantId], references: [id])
  partnerId     String
  partner       Partner @relation(fields: [partnerId], references: [id])
  name          String
  type          String
  basis         String
  rate          Float
  minAmount     Float?
  maxAmount     Float?
  conditions    String?
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  settlements   CommissionSettlement[]
}

model CommissionSettlement {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation("TenantCommissionSettlements", fields: [tenantId], references: [id])
  partnerId     String
  partner       Partner @relation(fields: [partnerId], references: [id])
  ruleId        String?
  rule          CommissionRule? @relation(fields: [ruleId], references: [id])
  period        String
  referenceId   String?
  amount        Float
  currency      String   @default("UGX")
  status        String   @default("PENDING")
  paidAt        DateTime?
  paidVia       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- BULK OPERATIONS ---

model BulkOperation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation("TenantBulkOps", fields: [tenantId], references: [id])
  type          String
  status        String   @default("PENDING")
  fileName      String
  fileSize      Int?
  totalRows     Int      @default(0)
  processedRows Int      @default(0)
  successRows   Int      @default(0)
  failedRows    Int      @default(0)
  errorSummary  String?
  errorDetails  String?
  configFile   String?
  resultFileUrl String?
  performedBy   String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- ANALYTICS & DASHBOARDS ---

model DashboardWidget {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation("TenantDashWidgets", fields: [tenantId], references: [id])
  name        String
  type        String
  dataSource  String
  config      String
  position    Int      @default(0)
  size        String   @default("MEDIUM")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReportTemplate {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation("TenantReportTemplates", fields: [tenantId], references: [id])
  name        String
  code        String   @unique
  description String?
  type        String
  format      String   @default("PDF")
  sections    String
  parameters  String?
  isActive    Boolean  @default(true)
