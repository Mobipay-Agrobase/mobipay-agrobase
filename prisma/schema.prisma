  ipAddress   String?
  createdAt   DateTime @default(now())
}

// --- RBAC: PERMISSIONS ---

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. "farmers:read", "vsla:approve_loans"
  module      String   // e.g. "farmers", "vsla", "compliance"
  action      String   // read, create, update, delete, approve, manage
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model RolePermission {
  id            String     @id @default(cuid())
  role          String     // SUPER_ADMIN, COUNTRY_ADMIN, TENANT_ADMIN, AGENT, EXTENSION_OFFICER, CBT, CASUAL, FARMER, VSLA_MEMBER
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

// --- SALES ---

model Sale {
  id              String   @id @default(cuid())
  tenantId        String?
  tenant          Tenant?  @relation("TenantSales", fields: [tenantId], references: [id])
  farmerId        String?
  farmer          FarmerProfile? @relation("FarmerSales", fields: [farmerId], references: [id])
  customerId      String?
  customerName    String?
  product         String
  category        String   @default("PRODUCE")  // PRODUCE or INPUT (EKIBBO: inputs=fertilizer/tarpaulin/seedlings/saws; produce=hulled coffee/cocoa/cassava/avocado/vanilla/jackfruit)
  quantity        String
  unitPrice       Float?
  totalAmount     Float?
  charges         Float?   // charges/fees (EKIBBO: visible to extension officers)
  taxAmount       Float?   // tax (EKIBBO: visible to extension officers)
  netAmount       Float?   // totalAmount - charges - taxAmount (auto-calc)
  paymentMethod   String?  // MOBILE_MONEY, BANK, CASH, LOAN_DEDUCTION
  loanDeducted    Float?   // amount deducted for loan repayment (EKIBBO: loan deduction from produce)
  loanBalanceAfter Float?  // remaining loan balance after this sale deduction
  batchId         String?  // E2E trace: ProductBatch.batchId being sold
  status          String   @default("PENDING")  // PENDING, APPROVED, INVOICED, PAID, DELIVERED, COMPLETED, CANCELLED
  approvedBy      String?  // extension officer who approved
  approvedAt      DateTime?
  paidAt          DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
}

