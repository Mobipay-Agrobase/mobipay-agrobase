  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     ResetVoucherRedemption[]
  payouts         ResetMerchantPayout[]
}

model ResetMerchantPayout {
  id              String   @id @default(cuid())
  merchantId      String
  merchant        ResetMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
