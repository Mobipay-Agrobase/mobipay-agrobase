  transactionRef  String?
  recordedById    String?
  createdAt       DateTime @default(now())
  @@index([saccoId])
  @@index([memberId])
}

model SaccoLoan {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
