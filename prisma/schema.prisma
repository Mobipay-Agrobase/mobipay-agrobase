  name          String
  type          String
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  address       String?
  country       String?
  commissionRate Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  commissions    CommissionRule[]
  settlements    CommissionSettlement[]
