  amount          Float
  currency        String   @default("UGX")
  allowedItems    String?
  allowedMerchants String?
  allowedLocations String?
  expiryDate      DateTime
  status          String   @default("ISSUED")
  issuedAt        DateTime @default(now())
  redeemedAt      DateTime?
  redeemedAtMerchantId String?
  createdAt       DateTime @default(now())

  redemptions     ResetVoucherRedemption[]
}

model ResetVoucherRedemption {
  id              String   @id @default(cuid())
  voucherId       String
  voucher         ResetVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  beneficiaryId   String
  beneficiary     ResetBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  merchantId      String
