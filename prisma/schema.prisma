// --- COOPERATIVE ERP: DOUBLE-ENTRY ACCOUNTING ---

model Account {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  code          String   // e.g., "1001", "2001"
  name          String   // e.g., "Cash", "Accounts Payable"
  type          String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  normalBalance String   @default("DEBIT") // DEBIT or CREDIT
  parentId      String?
  parent        Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[] @relation("AccountHierarchy")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  journalLines JournalLine[]
}

model JournalEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  date        DateTime @default(now())
  description String
  reference   String?  // e.g., "INTAKE-2024-001", "PAY-2024-001"
  status      String   @default("DRAFT") // DRAFT, POSTED, REVERSED
  createdBy   String?
  postedBy    String?
  postedAt    DateTime?
  reversedBy  String?
  reversedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines        JournalLine[]
  settlement    Settlement?    @relation("SettlementJournal")
}

model JournalLine {
  id            String       @id @default(cuid())
  journalEntryId String
  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  entryType     String       // DEBIT or CREDIT
  amount        Float
  description   String?
}

// --- COOPERATIVE ERP: PRODUCE INTAKE ---

model ProduceIntake {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  cooperativeId   String?
  farmerId        String?
  farmer          FarmerProfile? @relation("FarmerIntake", fields: [farmerId], references: [id])
  commodity       String
  variety         String?
  quantityKg      Float
  moistureContent Float?
  grade           String?  // A, B, C, Premium, Standard
  pricePerKg      Float
  totalAmount     Float
  intakeDate      DateTime @default(now())
  status          String   @default("DRAFT") // DRAFT, WEIGHED, GRADED, ACCEPTED, REJECTED, STORED
  receivedBy      String?
  warehouse       String?
  qualityNotes    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        CooperativePayment[]
}

// --- COOPERATIVE ERP: FARMER PAYMENTS ---

model CooperativePayment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  cooperativeId   String?
  intakeId        String?
  intake          ProduceIntake? @relation(fields: [intakeId], references: [id])
  farmerId        String?
  farmer          FarmerProfile? @relation("FarmerCoopPayment", fields: [farmerId], references: [id])
  phase           String   // FIRST, FINAL
  grossAmount     Float
  deductions      String?  // JSON array of {type, amount, description}
  netAmount       Float
  paymentMethod   String?  // MOBILE_MONEY, BANK, CASH
  status          String   @default("PENDING") // PENDING, PROCESSING, PAID, FAILED
  paidAt          DateTime?
  transactionRef  String?
  paidBy          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- BILLING: INVOICES ---

model Invoice {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  invoiceNumber String   @unique
  subscriptionId String?
  plan          String   // FREE, BASIC, STANDARD, ENTERPRISE, CUSTOM
  billingCycle  String   // MONTHLY, QUARTERLY, ANNUAL
  items         String   // JSON array of {description, amount, quantity, total}
  subtotal      Float
  tax           Float    @default(0)
  taxRate       Float    @default(0)
  total         Float
  currency      String   @default("USD")
  status        String   @default("DRAFT") // DRAFT, PENDING, PAID, OVERDUE, CANCELLED, PARTIALLY_PAID
  dueDate       DateTime
  paidAt        DateTime?
  paidAmount    Float    @default(0)
  reminderCount Int      @default(0)
  lastReminderAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- BILLING: USAGE TRACKING ---

model UsageRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  eventType   String   // FARMER_CREATED, USER_CREATED, API_CALL, SMS_SENT, etc.
  count       Int      @default(1)
  period      String   // "2026-06" (YYYY-MM format)
  recordedAt  DateTime @default(now())

  @@unique([tenantId, eventType, period])
}

// --- BILLING: DYNAMIC PLANS (P4) ---

/// A configurable billing plan. Replaces the 5 hardcoded price tables.
/// Super-admins can create/edit/deactivate plans via /api/admin/billing/plans.
model BillingPlan {
  id              String   @id @default(cuid())
  code            String   @unique // BASIC, STANDARD, ENTERPRISE, CUSTOM-001, etc.
  name            String   // Display name
  description     String?
  /// JSON array of module codes included in this plan
  modules         String   @default("[]")
  priceMonthly    Decimal  @db.Decimal(18, 2)
  priceAnnual     Decimal  @db.Decimal(18, 2)
  currency        String   @default("USD")
  maxUsers        Int      @default(10)
  maxFarmers      Int      @default(500)
  /// JSON: { sms: bool, api: bool, whiteLabel: bool, multiCurrency: bool, ... }
  features        String   @default("{}")
  isActive        Boolean  @default(true)
  isCustom        Boolean  @default(false) // true = created for a specific tenant
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantOverrides TenantPlanOverride[]

  @@index([isActive])
  @@index([isCustom])
}

/// Per-tenant custom pricing override. When present, the tenant's subscription
/// uses this price instead of the BillingPlan's default price.
model TenantPlanOverride {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  planId          String
  plan            BillingPlan @relation(fields: [planId], references: [id])
  /// Override price (if null, uses BillingPlan default)
  priceMonthly    Decimal? @db.Decimal(18, 2)
  priceAnnual     Decimal? @db.Decimal(18, 2)
  /// Override limits (if null, uses BillingPlan default)
  maxUsers        Int?
  maxFarmers      Int?
  /// Free-text reason for the override (audit trail)
  reason          String?
  /// When this override expires (null = never)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, planId])
  @@index([tenantId])
}

// --- PAYMENT TRANSACTIONS (Enhanced) ---

model PaymentTransaction {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  paymentId         String?
  payment           Payment? @relation("PaymentTransactions", fields: [paymentId], references: [id])
  provider          String   // MPAY, AINTEL, MTN_MOMO, MPESA, BANK_TRANSFER, MANUAL
  providerTxnRef    String?  // Provider's transaction reference
  type              String   // COLLECTION, DISBURSEMENT
  amount            Float
  currency          String   // UGX, GHS, KES, USD
  recipientPhone    String
  recipientName     String
  status            String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED, REFUNDED
  failureReason     String?
  initiatedBy       String?
  completedAt       DateTime?
  callbackReceived  Boolean  @default(false)
  callbackBody      String?  // Raw callback JSON
  metadata          String?  // JSON for additional data
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  escrowAsPayment    Escrow?       @relation("EscrowPayment")
  settlementAsPayment Settlement?  @relation("SettlementPayment")
}

// --- V1 MIGRATION TRACKING ---

model MigrationLog {
  id              String   @id @default(cuid())
  tableName       String   // V1 table name
  totalRecords    Int
  migratedRecords Int
  failedRecords   Int
  skippedRecords  Int
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED, PARTIAL
  startedAt       DateTime?
  completedAt     DateTime?
  errorLog        String?  // JSON array of errors
  executedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── MOBILE OFFLINE SYNC AUDIT TRAIL ────────────────────────────────────
// Every offline-queue push attempt (success or failure) is recorded here so
// the mobile Sync screen can show what happened and allow per-item re-sync.

model SyncAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  deviceId  String   // physical device that captured the record
  localId   String   // Hive-box key on the device
  type      String   // farmer, farmland, cultivation, purchase, ...
  status    String   // SUCCESS | FAILED
  remoteId  String?  // created/updated record id on success
  error     String?  // failure reason
  createdAt DateTime @default(now())

  @@index([tenantId, deviceId])
  @@index([tenantId, createdAt])
}

model IdMapping {
  id          String   @id @default(cuid())
  tableName   String   // V1 table name
  v1Id        String   // Original V1 ID
  v3Id        String   // New V3 ID
  createdAt   DateTime @default(now())

  @@unique([tableName, v1Id])
}

