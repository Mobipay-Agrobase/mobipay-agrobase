// ════════════════════════════════════════════════════════════
// IMPACT ENGINE (6-week sprint — Agrobase V3 Strategy)
//
// 5 new models that turn Agrobase from "operations platform" into
// "impact-native platform". Every transaction writes impact data.
//
//   ImpactBaseline        — captured once at enrolment, the comparison anchor
//   ImpactEvent           — hash-chained event ledger (Impact Passport)
//   ImpactKpiSnapshot     — nightly KPI computation per farmer (all 32 KPIs)
//   PracticeAdoption      — Farm5x practice adoption events (1M5C/M/K/T/D)
//   ClimateResilienceScore — 4-factor 0-100 score per farmer per month
// ════════════════════════════════════════════════════════════

model ImpactBaseline {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation("TenantImpactBaselines", fields: [tenantId], references: [id])
  farmerId          String   @unique
  farmer            FarmerProfile @relation("FarmerImpactBaseline", fields: [farmerId], references: [id], onDelete: Cascade)

  // Captured by extension officer at enrolment (12-question Flutter form)
  capturedAt        DateTime @default(now())
  capturedBy        String?
  captureMethod     String   @default("FLUTTER_FORM")  // FLUTTER_FORM | USSD | FIELD_OFFICER | IMPORTED

  // Income baseline (USD per year)
  baselineIncomeUsd      Float?
  baselineIncomeSources  String?  // JSON array: ["coffee", "maize", "vsla"]

  // Yield baseline (kg/ha for primary crop)
  baselineYieldKgHa      Float?
  baselineCrop           String?

  // Practice baseline (JSON array of practices already adopted)
  baselinePractices      String   @default("[]")  // JSON: ["shade_trees","no_till"]
  practiceCountBaseline  Int      @default(0)

  // Plot + household baseline
  plotCountBaseline      Int      @default(0)
  totalAreaHectares      Float?
  householdSize          Int?
  womenInLeadership      Boolean  @default(false)

  // Financial baseline
  hasBankAccount         Boolean  @default(false)
  hasMobileMoney         Boolean  @default(false)
  savingsBalanceUsd      Float?
  outstandingLoanUsd     Float?

  // Climate baseline
  climateRiskExposure    String?  // LOW | MEDIUM | HIGH | CRITICAL
  deforestationRisk      Boolean  @default(false)

  notes                  String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([tenantId])
  @@index([capturedAt])
}

model ImpactEvent {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation("TenantImpactEvents", fields: [tenantId], references: [id])
  farmerId          String
  farmer            FarmerProfile @relation("FarmerImpactEvents", fields: [farmerId], references: [id], onDelete: Cascade)

  // Event type: HARVEST, PRACTICE_ADOPTED, TRAINING_COMPLETED, PAYMENT_RECEIVED,
  // PLOT_VERIFIED, CERTIFICATION_ISSUED, LOAN_DISBURSED, LOAN_REPAID, ETC.
  eventType         String
  eventData         String   // JSON: event-specific payload

  // SHA-256 hash chain — each event hash = SHA256(prevHash + eventData + timestamp)
  // This makes the ledger tamper-evident. Anyone can verify the chain with a script.
  prevHash          String?
  hash              String   @unique

  // Optional links to other records
  relatedId         String?
  relatedType       String?  // PLOT | TRAINING | PAYMENT | CERTIFICATION | LOAN | PRACTICE

  // Actor (who triggered the event)
  actorId           String?
  actorName         String?
  actorType         String?  // FARMER | EXTENSION_OFFICER | SYSTEM | COOPERATIVE_MANAGER

  // Location (optional, for geo-tagged events)
  latitude          Float?
  longitude         Float?

  timestamp         DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([farmerId])
  @@index([eventType])
  @@index([timestamp])
}

model ImpactKpiSnapshot {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation("TenantImpactKpiSnapshots", fields: [tenantId], references: [id])
  farmerId          String
  farmer            FarmerProfile @relation("FarmerImpactKpiSnapshots", fields: [farmerId], references: [id], onDelete: Cascade)

  // KPI code (I-01 through CP-05 — see strategy brief)
  kpiCode           String   // e.g. "I-01", "Y-02", "C-04"
  pillar            String   // INCOME | YIELD | CLIMATE | INCLUSION | COMPLIANCE

  // Computed value
  value             Float
  unit              String   // USD | kg/ha | % | score | tCO2e | days
  period            String   // e.g. "2026-06" (monthly) or "2026A" (season)

  // Attribution
  attributionMethod String   @default("NAIVE")  // NAIVE | DID_MATCHED | SYNTHETIC_CONTROL
  controlGroupId    String?  // for DiD: the matched control farmer's ID
  confidenceScore   Float?   // 0-1 confidence in the attribution

  // Baseline + target for quick % calc
  baselineValue     Float?
  targetValue       Float?

  computedAt        DateTime @default(now())

  @@unique([farmerId, kpiCode, period])
  @@index([tenantId])
  @@index([farmerId])
  @@index([kpiCode])
  @@index([period])
  @@index([pillar])
}

model PracticeAdoption {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation("TenantPracticeAdoptions", fields: [tenantId], references: [id])
  farmerId          String
  farmer            FarmerProfile @relation("FarmerPracticeAdoptions", fields: [farmerId], references: [id], onDelete: Cascade)

  // Farm5x practice code — e.g. "1M5C_MUST" (shade trees), "1M5C_R1" (organic mulch)
  practiceCode      String
  cropType          String   // COFFEE | MAIZE | COCOA | TEA | DAIRY
  frameworkVariant  String   // 1M5C | 1M5M | 1M5K | 1M5T | 1M5D
  isMandatory       Boolean  @default(false)  // true if this is the "Must" practice

  // Adoption details
  adoptedAt         DateTime @default(now())
  adoptedBy         String?  // FARMER | EXTENSION_OFFICER
  plotId            String?  // optional: which plot

  // Verification — satellite or field officer confirmation
  verificationStatus String  @default("PENDING")  // PENDING | VERIFIED | REJECTED
  verificationMethod String?  // SATELLITE | FIELD_OFFICER | PHOTO | IoT
  verifiedAt        DateTime?
  verifiedBy        String?
  confidenceScore   Float?   // 0-1
  evidenceUrl       String?  // photo or satellite image URL

  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([farmerId])
  @@index([practiceCode])
  @@index([cropType])
  @@index([verificationStatus])
  @@index([adoptedAt])
}

model ClimateResilienceScore {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation("TenantClimateResilienceScores", fields: [tenantId], references: [id])
  farmerId          String
  farmer            FarmerProfile @relation("FarmerClimateResilienceScores", fields: [farmerId], references: [id], onDelete: Cascade)

  // Score period (monthly computation)
  period            String   @default("2026-06")  // YYYY-MM
  computedAt        DateTime @default(now())

  // Total score (0-100)
  score             Int

  // 4-factor breakdown
  practicePoints    Int      @default(0)   // /40 — Farm5x practice adoption
  yieldPoints       Int      @default(0)   // /20 — yield stability over 3 seasons
  trainingPoints    Int      @default(0)   // /20 — training completion
  climatePoints     Int      @default(0)   // /20 — climate exposure (lower risk = more points)

  // Risk category derived from score
  riskCategory      String   // LOW_RISK | MEDIUM_RISK | HIGH_RISK | CRITICAL_RISK

  // Inputs that produced this score (for auditability)
  inputs            String   // JSON: { practiceCount, yieldCV, trainingCount, climateExposure }

  // Trend vs previous period
  previousScore     Int?
  trend             String?  // IMPROVING | STABLE | DECLINING

  @@unique([farmerId, period])
  @@index([tenantId])
  @@index([farmerId])
  @@index([period])
  @@index([riskCategory])
  @@index([score])
}

// ════════════════════════════════════════════════════════════
// CROP STAGE MANAGEMENT — Farm5x + DREAM MRV + Cost + Carbon
//
// Flexible stage-event model that handles ALL crop verticals:
//   CropCore (rice/maize), CoffeeCore (coffee/cocoa),
//   LiveCore (livestock/dairy), OrchardCore, VegCore, etc.
//
// Each crop type has 11-20 stages defined in config (not DB).
// Each stage event stores its fields as JSON — no 200+ models needed.
// ════════════════════════════════════════════════════════════

model CropStageEvent {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation("TenantCropStageEvents", fields: [tenantId], references: [id])
  cultivationId   String   // links to Cultivation
  cultivation     Cultivation @relation("CultivationStageEvents", fields: [cultivationId], references: [id], onDelete: Cascade)

  // Stage identification
  cropVertical    String   // CROPCORE, COFFEECORE, LIVECORE, ORCHARDCORE, VEGCORE, etc.
  stageNumber     Int      // 1-20 (stage order within the vertical)
  stageName       String   // e.g. "Land Preparation", "Planting", "Harvest"
  eventType       String   // e.g. "LAND_PREP", "PLANTING", "FERTILIZER", "HARVEST"

  // The actual data for this stage event (all fields from the Excel)
  eventData       String   // JSON: all stage-specific fields

  // Photos / evidence
  photoUrls       String?  // JSON array of photo URLs

  // GPS + timing
  latitude        Float?
  longitude       Float?
  eventDate       DateTime @default(now())

  // Auto-calculated costs (sum of all input costs in eventData)
  inputCostTotal  Float    @default(0)  // seeds + fertilizer + pesticide + fuel + labor
  laborCost       Float    @default(0)
  materialCost    Float    @default(0)

  // Auto-calculated carbon (from IPCC emission factors applied to inputs)
  carbonKgCO2e    Float    @default(0)  // emissions from this stage event

  // DREAM MRV pipeline status for this event
  dreamData       Boolean  @default(false)  // D: data collected
  dreamRemote     Boolean  @default(false)  // R: satellite-verified
  dreamEvent      Boolean  @default(false)  // E: practice adoption detected
  dreamAnalytics  Boolean  @default(false)  // A: emissions calculated
  dreamMonitor    Boolean  @default(false)  // M: season-long monitoring tracked

  // Farm5x practice link (if this event is a Farm5x practice adoption)
  farm5xPractice  String?  // e.g. "1M5C_MUST", "1M5R_R1", "1M5D_R3"
  farm5xVariant   String?  // 1M5R, 1M5C, 1M5K, 1M5T, 1M5D, 1M5V, 1M5O, 1M5A

  // Actor
  createdBy       String?
  createdByName   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([cultivationId])
  @@index([cropVertical])
  @@index([stageNumber])
  @@index([eventDate])
  @@index([farm5xVariant])
}

// ─── Crop Calendar (from Excel: Crop Calendar Master) ────────
// Defines the seasonal stages per crop per country — when to plant,
// expected NDVI, expected rainfall, risks per stage.

model CropCalendar {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation("TenantCropCalendars", fields: [tenantId], references: [id])

  cropName        String   // Coffee, Maize, Rice, Cocoa, Tea, Dairy, etc.
  country         String   // Uganda, Ghana, Kenya
  variety         String?  // e.g. SL28, Longe 10H

  // Calendar definition (JSON: array of stages with timing)
  stages          String   // JSON: [{ stageName, startDay, endDay, expectedNDVI: {min,max}, expectedRainfall: {minMm,maxMm}, risks: [] }]

  totalDurationDays Int?
  plantingWindows String?  // JSON: [{ startMonth, endMonth }]

  // Linked Farm5x variant
  farm5xVariant   String?  // 1M5C, 1M5M, 1M5K, 1M5T, 1M5D, etc.

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cropName, country, variety])
  @@index([tenantId])
  @@index([cropName])
  @@index([country])
}

// ═══════════════════════════════════════════════════════════════════════════
// VENDOR FINANCING & BILLING ENGINE
// ═══════════════════════════════════════════════════════════════════════════
// Configurable billing engine supporting 3 models:
//   SUBSCRIPTION     — fixed annual/monthly fee, no transaction fees
//   VENDOR_FINANCING — no upfront, fees only, investment recovered over time
//   HYBRID           — lower subscription + lower per-kg fee
//
// upfrontInvestment and feeRate are MUTABLE (editable from admin UI).
// Every change is logged in BillingInvestmentChange / BillingFeeRateChange.

model BillingAgreement {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  tenant                Tenant   @relation(fields: [tenantId], references: [id])

  billingModel          String   // SUBSCRIPTION | VENDOR_FINANCING | HYBRID
  costTrackingMode      String   @default("FIXED")  // FIXED | ACTUAL

  subscriptionAmount    Decimal? @db.Decimal(18, 2)
  subscriptionCurrency  String?
  subscriptionCycle     String?  // MONTHLY | ANNUAL

  feeType               String?  // PERCENTAGE | PER_KG | FLAT_PER_TXN | NONE
  feeRate               Decimal? @db.Decimal(8, 4)   // EDITABLE
  feeAppliesTo          String?  // PURCHASES | SALES | PAYOUTS | ALL
  feeMinPerTxn          Decimal? @default(0) @db.Decimal(18, 2)
  feeMaxPerMonth        Decimal? @db.Decimal(18, 2)

  upfrontInvestment     Decimal? @db.Decimal(18, 2)  // EDITABLE
  recoveryPeriodMonths  Int?
  recurringMonthlyCost  Decimal? @db.Decimal(18, 2)

  status                String   @default("ACTIVE")  // ACTIVE | RECOVERED | TERMINATED | SUPERSEDED
  startDate             DateTime
  endDate               DateTime?
  recoveredAt           DateTime?
  supersededById        String?

  recoveredAmount       Decimal  @default(0) @db.Decimal(18, 2)
  totalFeesCollected    Decimal  @default(0) @db.Decimal(18, 2)
  totalRecurringCost    Decimal  @default(0) @db.Decimal(18, 2)

  feeLedger             TransactionFeeLedger[]
  reconciliations       MonthlyReconciliation[]
  investmentChanges     BillingInvestmentChange[]
  feeRateChanges        BillingFeeRateChange[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId, status])
  @@index([status])
}

model TransactionFeeLedger {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  agreementId           String
  agreement             BillingAgreement @relation(fields: [agreementId], references: [id])

  transactionType       String   // PURCHASE | SALE | PAYOUT
  transactionId         String
  transactionAmount     Decimal  @db.Decimal(18, 2)
  transactionQuantity   Decimal? @db.Decimal(18, 2)

  feeType               String
  feeRate               Decimal  @db.Decimal(8, 4)   // snapshot at txn time
  feeAmount             Decimal  @db.Decimal(18, 2)
  momoGatewayFee        Decimal  @default(0) @db.Decimal(18, 2)
  mobipayFee            Decimal  @db.Decimal(18, 2)

  allocatedToRecovery   Decimal  @default(0) @db.Decimal(18, 2)
  allocatedToProfit     Decimal  @default(0) @db.Decimal(18, 2)

  reversed              Boolean  @default(false)
  reversedAt            DateTime?
  reversalOfId          String?

  recordedAt            DateTime @default(now())

  @@index([tenantId, recordedAt])
  @@index([agreementId])
  @@index([transactionId])
  @@index([transactionType, reversed])
}

model MonthlyReconciliation {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  agreementId           String
  agreement             BillingAgreement @relation(fields: [agreementId], references: [id])

  period                String   // "2026-07"
  periodStart           DateTime
  periodEnd             DateTime

  transactionCount      Int      @default(0)
  grossVolume           Decimal  @default(0) @db.Decimal(18, 2)
  totalFeesCollected    Decimal  @default(0) @db.Decimal(18, 2)
  momoGatewayFees       Decimal  @default(0) @db.Decimal(18, 2)
  mobipayFees           Decimal  @default(0) @db.Decimal(18, 2)

  costTrackingMode      String
  recurringCostIncurred Decimal  @default(0) @db.Decimal(18, 2)
  costBreakdown         Json?
  surplusApplied        Decimal  @default(0) @db.Decimal(18, 2)

  investmentBefore      Decimal? @db.Decimal(18, 2)
  investmentAfter       Decimal? @db.Decimal(18, 2)
  recoveredThisMonth    Decimal? @db.Decimal(18, 2)

  status                String   @default("OPEN")  // OPEN | FINALIZED | EMAILED
  finalizedAt           DateTime?
  statementPdfUrl       String?
  emailedTo             String[]

  createdAt             DateTime @default(now())

  @@unique([tenantId, period])
  @@index([tenantId, period])
  @@index([agreementId])
}

model BillingInvestmentChange {
  id              String   @id @default(cuid())
  agreementId     String
  agreement       BillingAgreement @relation(fields: [agreementId], references: [id])
  changedByUserId String
  previousAmount  Decimal  @db.Decimal(18, 2)
  newAmount       Decimal  @db.Decimal(18, 2)
  reason          String
  changedAt       DateTime @default(now())

  @@index([agreementId])
  @@index([changedByUserId])
}

model BillingFeeRateChange {
  id              String   @id @default(cuid())
  agreementId     String
  agreement       BillingAgreement @relation(fields: [agreementId], references: [id])
  changedByUserId String
  previousRate    Decimal  @db.Decimal(8, 4)
  newRate         Decimal  @db.Decimal(8, 4)
  reason          String
  changedAt       DateTime @default(now())

  @@index([agreementId])
  @@index([changedByUserId])
}

// ═══════════════════════════════════════════════════════════════════════════
// SUPPORT TICKETS + QUOTES (Phase 4)
// ═══════════════════════════════════════════════════════════════════════════

model SupportTicket {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  subject     String
  message     String
  category    String   @default("GENERAL") // BILLING, PAYMENT, TECHNICAL, GENERAL
  priority    String   @default("NORMAL")  // LOW, NORMAL, HIGH, URGENT
  status      String   @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdById String   // User who submitted the ticket
  createdBy   User     @relation("SupportTicketCreator", fields: [createdById], references: [id])
  assignedToId String? // MOBIPAY_FINANCE user handling the ticket
  assignedTo  User?    @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])
  replies     SupportTicketReply[]
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([status, priority])
  @@index([assignedToId])
}

model SupportTicketReply {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message     String
  fromUserId  String
  fromUser    User     @relation("TicketReplyUser", fields: [fromUserId], references: [id])
  fromRole    String   // TENANT_USER, MOBIPAY_FINANCE, SUPER_ADMIN
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

model Quote {
  id              String   @id @default(cuid())
  prospectName    String
  prospectEmail   String?
  prospectPhone   String?
  prospectCountry String?
  billingModel    String   // SUBSCRIPTION, VENDOR_FINANCING, HYBRID
  feeType         String?  // PERCENTAGE, PER_KG, FLAT_PER_TXN
  feeRate         Decimal? @db.Decimal(8, 4)
  subscriptionAmount Decimal? @db.Decimal(18, 2)
  upfrontInvestment Decimal? @db.Decimal(18, 2)
  recoveryPeriodMonths Int?
  recurringMonthlyCost Decimal? @db.Decimal(18, 2)
  notes           String?
  status          String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  validUntil      DateTime?
  createdById     String
  createdBy       User     @relation("QuoteCreator", fields: [createdById], references: [id])
  convertedAgreementId String? // points to BillingAgreement if quote was accepted
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdById])
}

// ═══════════════════════════════════════════════════════════════════════════
// NSSF VOLUNTARY SAVINGS COLLECTION MODULE
// ═══════════════════════════════════════════════════════════════════════════
// Collects voluntary savings contributions from farmers for NSSF Uganda,
// routes funds to Klimotrust (who remits to NSSF), and tracks commission.

model NssfRegistration {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  farmerId        String   @unique
  farmer          FarmerProfile @relation("NssfRegistrationFarmer", fields: [farmerId], references: [id])
  nssfNumber      String?  // NSSF member number (assigned by NSSF)
  nationalId      String   // National ID number (required for KYC)
  fullName        String   // Full name as per national ID
  dateOfBirth     DateTime?
  gender          String?
  phoneNumber     String
  email           String?
  district        String?
  village         String?
  valueChain      String?  // coffee, cocoa, vanilla, etc.
  employer        String?  // Usually "Self-employed (Farmer)"
  activationStatus String  @default("PENDING") // PENDING, VERIFIED, ACTIVATED, REJECTED
  verifiedAt      DateTime?
  activatedAt     DateTime?
  registeredById  String   // User who registered the farmer
  contributions   NssfContribution[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, nationalId])
  @@index([tenantId, activationStatus])
  @@index([farmerId])
}

model NssfContribution {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  registrationId  String
  registration    NssfRegistration @relation(fields: [registrationId], references: [id])
  farmerId        String
  farmer          FarmerProfile @relation("NssfContributionFarmer", fields: [farmerId], references: [id])
  amount          Decimal  @db.Decimal(18, 2)
  currency        String   @default("UGX")
  paymentMethod   String   // MTN_MOMO, AIRTEL_MONEY, CARD, BANK_TRANSFER, CASH
  paymentReference String? // Flutterwave or MoMo transaction reference
  paymentProvider String?  // FLUTTERWAVE, MTN_DIRECT, AIRTEL_DIRECT
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  failureReason   String?
  contributionDate DateTime @default(now())
  completedAt     DateTime?
  // Settlement tracking
  settlementId    String?
  settlement      FundSettlement? @relation(fields: [settlementId], references: [id])
  settlementStatus String @default("UNSETTLED") // UNSETTLED, SETTLED
  // Audit
  initiatedById   String   // User who initiated (farmer self-service or officer)
  channel         String   @default("WEB") // WEB, MOBILE, USSD, FIELD_OFFICER
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([farmerId])
  @@index([settlementStatus])
  @@index([contributionDate])
}

model FundSettlement {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  settlementNumber String  @unique
  settlementDate  DateTime @default(now())
  periodStart     DateTime
  periodEnd       DateTime
  totalAmount     Decimal  @db.Decimal(18, 2)
  contributionCount Int
  currency        String   @default("UGX")
  status          String   @default("PENDING") // PENDING, SENT, CONFIRMED, FAILED
  // Destination (Klimotrust account)
  destinationAccount String? // Bank account or MoMo number
  destinationName String?
  destinationProvider String? // BANK, MTN, AIRTEL
  sentAt          DateTime?
  confirmedAt     DateTime?
  confirmationRef String?  // Bank/MoMo confirmation reference
  // Commission calculation
  commissionAmount Decimal? @db.Decimal(18, 2) // 30% of totalAmount
  mobipayShare    Decimal? @db.Decimal(18, 2)
  klimotrustShare Decimal? @db.Decimal(18, 2)
  // Audit
  createdById     String
  notes           String?
  contributions   NssfContribution[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([settlementDate])
}

model NssfCommission {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  period          String   @unique // "2026-07" (YYYY-MM)
  periodStart     DateTime
  periodEnd       DateTime
  totalContributions Decimal @db.Decimal(18, 2)
  contributionCount Int
  commissionRate  Decimal  @db.Decimal(5, 4) @default(0.30) // 30%
  commissionAmount Decimal @db.Decimal(18, 2) // 30% of totalContributions
  mobipaySharePercent Decimal @db.Decimal(5, 4) @default(0.50) // 50% placeholder
  mobipayShare    Decimal  @db.Decimal(18, 2)
  klimotrustShare Decimal  @db.Decimal(18, 2)
  receivedAt      DateTime?
  receivedAmount  Decimal? @db.Decimal(18, 2)
  status          String   @default("PENDING") // PENDING, RECEIVED, RECONCILED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, period])
}

// ============================================================
// SECURITY V3 — Tamper-evident audit log (hash-chained)
// Each row's hash is computed from the previous row's hash + this row's data.
// Any tampering breaks the chain — auditors can verify integrity with a script.
// ============================================================

model SecureAuditLog {
  id          String   @id @default(cuid())
  // Hash chain fields — make tampering detectable
  hash        String   @unique  // SHA-256(prevHash + canonical(data) + timestamp)
  prevHash    String?  // null for the first entry only
  chainIndex  Int      @unique  // sequential counter for chain verification
  // Audit fields
  tenantId    String?
  userId      String?  // nullable — some events are system-generated
  actorName   String?  // denormalized for forensics even if user is deleted
  actorRole   String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, APPROVE, DISBURSE, etc.
  entityType  String   // VslaGroup, Payment, User, etc.
  entityId    String?
  description String?
  metadata    String?  // JSON string — encrypted PII if needed
  ipAddress   String?
  userAgent   String?
  httpMethod  String?
  path        String?
  // Integrity
  createdAt   DateTime @default(now())
  
  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// ============================================================
// VSLA V2 — SRS v3 Compliant Module (July 2026)
// Implements: key holders, unanimous approval, E-Teller, auto-eligibility,
// SMS OTP login, loan freeze, cycle archive, group cashbox, member KYC
// All models use V2 suffix to avoid collision with existing V1 models.
// ============================================================

// ─── Group (V2) — with key holder count, cycle config, cashbox ───
model VslaGroupV2 {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  code              String   @unique
  region            String?
  district          String?
  description       String?
  // Group config (per SRS 3.3)
  sharePrice        Float    @default(5000)  // UGX per share
  loanMultiplier    Float    @default(3)     // max loan = savings × multiplier
  welfareContribution Float  @default(0)     // per-meeting welfare contribution
  lateAttendanceFine Float   @default(0)
  absenceFine        Float   @default(0)
  // Cycle config
  cycleLengthDays   Int      @default(365)   // default cycle length
  // Key holder config (SRS: 3-6 per group)
  minKeyHolders     Int      @default(3)
  maxKeyHolders     Int      @default(6)
  // Status
  status            String   @default("ACTIVE") // ACTIVE | SUSPENDED | CLOSED
  cashboxBalance    Float    @default(0)     // running cashbox balance
  formedAt          DateTime @default(now())
  closedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  keyHolders        VslaKeyHolderV2[]
  members           VslaMemberV2[]
  cycles            VslaCycleV2[]
  loans             VslaLoanV2[]
  meetings          VslaMeetingV2[]
  cashboxEntries    VslaCashboxEntryV2[]
  transactions      VslaTransactionV2[]
}

// ─── Key Holder (V2) — 3-6 per group, unanimous loan approval ───
model VslaKeyHolderV2 {
  id            String   @id @default(cuid())
  groupId       String
  group         VslaGroupV2 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId      String   // links to VslaMemberV2.id
  role          String   // CHAIRPERSON | SECRETARY | TREASURER | KEYHOLDER
  nationalId    String?
  phone         String
  fullName      String
  status        String   @default("ACTIVE") // ACTIVE | REMOVED
  assignedAt    DateTime @default(now())
  removedAt     DateTime?
  createdAt     DateTime @default(now())

  loanApprovals VslaLoanApprovalV2[]

  @@unique([groupId, memberId])
}

// ─── Member (V2) — with KYC, PIN, SMS login ───
model VslaMemberV2 {
  id              String   @id @default(cuid())
  groupId         String
  group           VslaGroupV2 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId        String   @unique  // system-generated member ID (e.g. VSLA-MBR-001)
  fullName        String
  phone           String
  email           String?
  nationalId      String?
  gender          String?  // MALE | FEMALE | OTHER
  // KYC (SRS 3.4)
  photoUrl        String?  // member photo
  idPhotoUrl      String?  // national ID photo
  // PIN for SMS login (SRS 3.4 — "Send a welcome SMS with PIN")
  pinHash         String?  // bcrypt hash of PIN
  pinSetAt        DateTime?
  // Savings
  totalShares     Int      @default(0)
  totalSavings    Float    @default(0)
  // Status
  status          String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED | EXITED
  activatedAt     DateTime?  // set when first share purchase happens
  joinedAt        DateTime @default(now())
  exitedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  savings         VslaTransactionV2[]
  loans           VslaLoanV2[]
  smsOtps         VslaSmsOtpV2[]
  etellerAssignments VslaETellerV2[]
  meetingAttendance VslaMeetingAttendanceV2[]
}

// ─── Cycle (V2) — with freeze date + archive ───
model VslaCycleV2 {
  id              String   @id @default(cuid())
  groupId         String
  group           VslaGroupV2 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String   // e.g. "Cycle 2026-H1"
  startDate       DateTime
  endDate         DateTime
  // LOAN FREEZE (SRS 5.3 — 30 days before cycle end)
  freezeDate      DateTime?  // auto-computed = endDate - 30 days
  isFrozen        Boolean  @default(false)
  frozenAt        DateTime?
  // Share-out
  shareOutDate    DateTime?
  shareOutPerShare Float  @default(0)
  totalSavings    Float    @default(0)
  totalInterest   Float    @default(0)
  totalWelfare    Float    @default(0)
  totalFines      Float    @default(0)
  // Archive (SRS 5.3 — "Archive the data with no further edits allowed")
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  // Status
  status          String   @default("ACTIVE") // ACTIVE | FROZEN | SHARE_OUT | CLOSED | ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loans           VslaLoanV2[]
}

// ─── Loan (V2) — with auto-eligibility + unanimous approval ───
model VslaLoanV2 {
  id              String   @id @default(cuid())
  groupId         String
  group           VslaGroupV2 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId        String
  member          VslaMemberV2 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cycleId         String?
  cycle           VslaCycleV2? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  // Loan details
  amount          Float
  interestRate    Float    // %
  totalRepayable  Float
  amountRepaid    Float    @default(0)
  outstanding     Float    @default(0)
  purpose         String
  termDays        Int      @default(90)
  // Auto-eligibility check (SRS 5.1)
  eligibilityChecked    Boolean @default(false)
  eligibilityPassed     Boolean @default(false)
  eligibilityFailReason String?
  eligibilityCheckedAt  DateTime?
  // Status flow: PENDING → SYSTEM_APPROVED → KEYHOLDER_APPROVED → DISBURSED → REPAID
  //              PENDING → SYSTEM_REJECTED (auto-eligibility failed)
  //              PENDING → REJECTED (key holders rejected)
  status          String   @default("PENDING")
  // Dates
  applicationDate DateTime @default(now())
  systemApprovedAt DateTime?
  disbursedAt     DateTime?
  expectedRepaymentDate DateTime?
  repaidAt        DateTime?
  closedAt        DateTime?
  // Audit
  disbursedById   String?  // who disbursed (E-Teller or Group Admin)
  disbursedByName String?
  transactionRef  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  approvals       VslaLoanApprovalV2[]
  repayments      VslaTransactionV2[]
}

// ─── Loan Approval (V2) — individual key holder votes for unanimous approval ───
model VslaLoanApprovalV2 {
  id              String   @id @default(cuid())
  loanId          String
  loan            VslaLoanV2 @relation(fields: [loanId], references: [id], onDelete: Cascade)
  keyHolderId     String
  keyHolder       VslaKeyHolderV2 @relation(fields: [keyHolderId], references: [id], onDelete: Cascade)
  // Vote
  decision        String   // APPROVED | REJECTED
  comments        String?
  approvedAt      DateTime @default(now())
  // Audit
  ipAddress       String?
  userAgent       String?

  @@unique([loanId, keyHolderId])
}

// ─── Meeting (V2) — with E-Teller assignment ───
model VslaMeetingV2 {
  id              String   @id @default(cuid())
  groupId         String
  group           VslaGroupV2 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  meetingNumber   Int      @default(1)
  title           String
  meetingDate     DateTime
  startTime       String?
  endTime         String?
  location        String?
  agenda          String?
  notes           String?
  // Status
  status          String   @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | CONCLUDED | CANCELLED
  attendanceCount Int      @default(0)
  totalMembers    Int      @default(0)
  // Meeting totals
  totalSavings    Float    @default(0)
  totalLoanDisbursed Float @default(0)
  totalLoanRepaid Float    @default(0)
  totalWelfare    Float    @default(0)
  totalFines      Float    @default(0)
  // Cashbox after meeting
  cashboxBefore   Float    @default(0)
  cashboxAfter    Float    @default(0)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  etellerAssignments VslaETellerV2[]
  attendance      VslaMeetingAttendanceV2[]
  transactions    VslaTransactionV2[]
}

// ─── E-Teller Assignment (V2) — any member can act as E-Teller per SRS ───
model VslaETellerV2 {
  id              String   @id @default(cuid())
  meetingId       String
  meeting         VslaMeetingV2 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId        String
  member          VslaMemberV2 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedAt      DateTime @default(now())
  assignedById    String?
  // E-Teller can record: savings, loans, welfare, fines
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([meetingId, memberId])
}

// ─── Meeting Attendance (V2) ───
model VslaMeetingAttendanceV2 {
  id              String   @id @default(cuid())
  meetingId       String
  meeting         VslaMeetingV2 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId        String
  member          VslaMemberV2 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  present         Boolean  @default(false)
  arrivedLate     Boolean  @default(false)  // triggers lateAttendanceFine
  arrivalTime     String?
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([meetingId, memberId])
}

// ─── Cashbox Entry (V2) — group cashbox ledger (SRS 5.2) ───
model VslaCashboxEntryV2 {
  id              String   @id @default(cuid())
  groupId         String
  group           VslaGroupV2 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  meetingId       String?
  // Transaction details
  type            String   // SAVING_IN | LOAN_OUT | LOAN_REPAY_IN | WELFARE_IN | FINE_IN | WELFARE_OUT | SHARE_OUT
  amount          Float
  balanceBefore   Float
  balanceAfter    Float
  // Reference
  memberId        String?
  loanId          String?
  transactionRef  String
  description     String?
  // Audit
  recordedById    String?  // E-Teller or Group Admin
  recordedByName  String?
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ─── Transaction (V2) — master ledger for all VSLA transactions ───
model VslaTransactionV2 {
  id              String   @id @default(cuid())
  groupId         String
  group           VslaGroupV2 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId        String?
  member          VslaMemberV2? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  meetingId       String?
  meeting         VslaMeetingV2? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  loanId          String?
  loan            VslaLoanV2? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  // Transaction details
  type            String   // SAVING | LOAN_DISBURSEMENT | LOAN_REPAYMENT | WELFARE_CONTRIBUTION | WELFARE_CLAIM | FINE | SHARE_OUT
  amount          Float
  direction       String   // IN | OUT (relative to cashbox)
  description     String?
  transactionRef  String
  status          String   @default("COMPLETED")
  // Audit
  recordedById    String?
  recordedByName  String?
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ─── SMS OTP (V2) — for member login via SMS (SRS 3.4, 4) ───
model VslaSmsOtpV2 {
  id              String   @id @default(cuid())
  memberId        String
  member          VslaMemberV2 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  phone           String
  otpHash         String   // bcrypt hash of OTP
  otpCode         String?  // stored temporarily for dev/debug — remove in production
  purpose         String   // LOGIN | REGISTER | RESET_PIN
  // Status
  isUsed          Boolean  @default(false)
  usedAt          DateTime?
  expiresAt       DateTime  // 5-minute expiry
  // Audit
  ipAddress       String?
  attempts        Int      @default(0)  // wrong attempts
  createdAt       DateTime @default(now())
}

// ============================================================
// ReSET MARKETLINK — Humanitarian Voucher + Cash Platform
// 15 new models for FCDO ReSET Programme
// All tenant-scoped — isolated from EKIBBO/Kilimo tenants
// ============================================================

model ResetBeneficiary {
  id              String   @id @default(cuid())
  tenantId        String
  beneficiaryId   String   @unique
  householdId     String
  fullName        String
  phone           String
  nationalId      String?
  refugeeId       String?
  gender          String?
  dateOfBirth     DateTime?
  settlement      String
  village         String?
  enrolledBy      String
  agentId         String?
  photoUrl        String?
  idPhotoUrl      String?
  biometricHash   String?
  walletBalance   Float    @default(0)
  voucherBalance  Float    @default(0)
  status          String   @default("ACTIVE")
  pinHash         String?
  enrolledAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vouchers        ResetVoucher[]
