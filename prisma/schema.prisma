generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AGROBASE V3 — FULL MULTI-TENANT SCHEMA
// MobiPay AgroSys Limited
// ============================================

// --- TENANT & ORG HIERARCHY ---

model Tenant {
  id          String   @id @default(cuid())
  name        String
  type        String   // SUPER_ADMIN, COUNTRY, NGO, COOPERATIVE, AGRIBUSINESS, EXPORTER, MFI, BANK, INPUT_SUPPLIER, PROCESSING, VSLA_PROVIDER, SACCO
  country         String?             // Uganda, Ghana, Kenya
  defaultCurrency String   @default("UGX") // UGX, GHS, KES — derived from country, overridable
  parentId        String?
  parent      Tenant?  @relation("TenantHierarchy", fields: [parentId], references: [id])
  children    Tenant[] @relation("TenantHierarchy")
  isActive    Boolean  @default(true)
  features    String?  // JSON: tenant-specific feature flags e.g. {"purchaseWorkflow":true,"farmerLedger":true

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  syncAuditLogs      SyncAuditLog[]
  farmerGroups FarmerGroup[]
  farmerProfiles FarmerProfile[]
  vslaGroups  VslaGroup[]
  companies   Company[]
  paymentAccounts PaymentAccount[]
  moduleEntitlements ModuleEntitlement[]
  subscriptions     Subscription[]
  loanProducts      LoanProduct[]
  apiKeys     ApiKey[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  produceIntakes   ProduceIntake[]
  cooperativePayments CooperativePayment[]
  invoices         Invoice[]
  usageRecords     UsageRecord[]
  paymentTransactions PaymentTransaction[]
  trainings        Training[]
  surveys          Survey[]
  consignments     Consignment[]
  processingBatches ProcessingBatch[]
  deliveries       Delivery[]
  messages             Message[]
  feedback             Feedback[]
  satelliteImages      SatelliteImage[]
  ndvTimeSeries        NdvTimeSeries[]
  rainfallRecords      RainfallRecord[]
  deforestationAlerts  DeforestationAlert[]
  carbonFootprints     CarbonFootprint[]
  carbonProjects       CarbonProject[]           @relation("TenantCarbonProjects")
  carbonCredits        CarbonCredit[]            @relation("TenantCarbonCredits")
  carbonVerifications  CarbonVerification[]      @relation("TenantCarbonVerifications")
  carbonProjectMethodologies CarbonProjectMethodology[] @relation("TenantCarbonProjectMethodologies")
  plots                Plot[]                    @relation("TenantPlots")
  plotSeasons          PlotSeason[]              @relation("TenantPlotSeasons")
  plotVerifications    PlotVerification[]        @relation("TenantPlotVerifications")
  plotDocuments        PlotDocument[]            @relation("TenantPlotDocuments")
  mfiPartners         MfiPartner[]             @relation("TenantMfiPartners")
  mfiLoanProducts     MfiLoanProduct[]         @relation("TenantMfiLoanProducts")
  mfiLoans            MfiLoan[]                @relation("TenantMfiLoans")
  mfiLoanSchedules    MfiLoanSchedule[]        @relation("TenantMfiLoanSchedules")
  mfiRepayments       MfiRepayment[]           @relation("TenantMfiRepayments")
  cbamCalculations     CbamCalculation[]
  exchangeRates        ExchangeRate[]  @relation("TenantExchangeRates")
  escrows             Escrow[]       @relation("TenantEscrow")
  settlements         Settlement[]    @relation("TenantSettlement")
  cbamReports          CbamReport[]
  rainforestCertifications RainforestCertification[]
  globalGapCertifications  GlobalGapCertification[]
  productBatches       ProductBatch[]
  traceEvents          TraceEvent[]
  farmPassports        FarmPassport[]
  costOfCultivations   CostOfCultivation[]
  notificationTemplates  NotificationTemplate[] @relation("TenantNotifications")
  notifications         Notification[]       @relation("TenantNotifRecords")
  notificationPreferences NotificationPreference[] @relation("TenantNotifPrefs")
  webhookEndpoints     WebhookEndpoint[]     @relation("TenantWebhooks")
  warehouses           Warehouse[]           @relation("TenantWarehouses")
  stockItems           StockItem[]           @relation("TenantStockItems")
  stockMovements       StockMovement[]       @relation("TenantStockMovements")
  gradeDefinitions     GradeDefinition[]     @relation("TenantGradeDefs")
  qualityInspections   QualityInspection[]   @relation("TenantQualityInspections")
  contracts            Contract[]            @relation("TenantContracts")
  vehicles             Vehicle[]             @relation("TenantVehicles")
  shipments            Shipment[]            @relation("TenantShipments")
  partners             Partner[]             @relation("TenantPartners")
  commissionRules      CommissionRule[]      @relation("TenantCommissionRules")
  commissionSettlements CommissionSettlement[] @relation("TenantCommissionSettlements")
  bulkOperations       BulkOperation[]       @relation("TenantBulkOps")
  dashboardWidgets     DashboardWidget[]     @relation("TenantDashWidgets")
  reportTemplates      ReportTemplate[]      @relation("TenantReportTemplates")
  scheduledReports     ScheduledReport[]     @relation("TenantScheduledReports")
  translations         Translation[]         @relation("TenantTranslations")
  brandingConfigs      BrandingConfig[]      @relation("TenantBranding")
  inputDealers         InputDealer[]
  inputProducts        InputProduct[]
  inputRequests        InputRequest[]
  marketProducts       MarketProduct[]
  marketMatches        MarketMatch[]
  fileAttachments      FileAttachment[]
  ussdSessions         UssdSession[]
  ivrCampaigns         IvrCampaign[]
  smsBroadcasts        SmsBroadcast[]
  vslaLoans            VslaLoan[]
  vslaLoanRepayments   VslaLoanRepayment[]
  vslaMeetings         VslaMeeting[]
  vslaAttendances      VslaAttendance[]
  exportJobs           ExportJob[]            @relation("TenantExportJob")
  transporters         Transporter[]          @relation("TenantTransporters")
  transportVehicles    TransportVehicle[]     @relation("TenantTransportVehicles")
  transportRequests    TransportRequest[]     @relation("TenantTransportRequests")
  transportTrips       TransportTrip[]        @relation("TenantTransportTrips")
  transportCharges     TransportCharge[]      @relation("TenantTransportCharges")
  ccrpEnrollments      CcrpEnrollment[]        @relation("TenantCcrpEnrollments")
  sales                Sale[]                  @relation("TenantSales")
  // ─── Impact Engine (6-week sprint) ───
  impactBaselines      ImpactBaseline[]       @relation("TenantImpactBaselines")
  impactEvents         ImpactEvent[]          @relation("TenantImpactEvents")
  impactKpiSnapshots   ImpactKpiSnapshot[]    @relation("TenantImpactKpiSnapshots")
  practiceAdoptions    PracticeAdoption[]     @relation("TenantPracticeAdoptions")
  climateResilienceScores ClimateResilienceScore[] @relation("TenantClimateResilienceScores")
  cropStageEvents     CropStageEvent[]     @relation("TenantCropStageEvents")
  cropCalendars       CropCalendar[]       @relation("TenantCropCalendars")
  // ─── EKIBBO: Ledger + Input Distribution + Crop Insurance ───
  farmerLedgerEntries FarmerLedgerEntry[]
  inputDistributions  InputDistribution[]
  cropInsurances      CropInsurance[]
  // ─── Vendor Financing & Billing Engine ───
  billingAgreement       BillingAgreement?
  transactionFeeLedger   TransactionFeeLedger[]
  monthlyReconciliations MonthlyReconciliation[]
  // ─── Support + Quotes ───
  supportTickets         SupportTicket[]
  // ─── NSSF Collection Module ───
  nssfRegistrations      NssfRegistration[]
  nssfContributions      NssfContribution[]
  fundSettlements        FundSettlement[]
  nssfCommissions        NssfCommission[]
  // ─── P4: Dynamic Billing ───
  planOverrides          TenantPlanOverride[]
  // ─── P7-SAA: SACCO Management ───
  saccos                 Sacco[]
  saccoLoans             SaccoLoan[]
  saccoLoanRepayments    SaccoLoanRepayment[]
  saccoMeetings          SaccoMeeting[]
}

// --- USERS & AUTH ---

model User {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  role          String   // SUPER_ADMIN, COUNTRY_ADMIN, TENANT_ADMIN, AGENT, EXTENSION_OFFICER, CBT, CASUAL, FARMER, VSLA_MEMBER, VSLA_PROVIDER_ADMIN, SACCO_ADMIN, SACCO_OFFICER
  email         String?
  phone         String   @unique
  passwordHash  String?
  firstName     String
  lastName      String
  avatarUrl     String?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  // ─── Password Reset (OTP flow) ───
  passwordResetToken  String?
  passwordResetExpiresAt DateTime?
  passwordResetUsedAt  DateTime?
  // ─── 2FA (TOTP) ───
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  twoFactorBackupCodes String?  // JSON array of hashed backup codes
  twoFactorEnrolledAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agentAssignments   AgentAssignment[]
  auditLogs          AuditLog[]
  farmerProfiles     FarmerProfile[]
  notifications      Notification[] @relation("UserNotifications")
  notificationPreferences NotificationPreference[] @relation("UserNotifPrefs")
  managedWarehouse   Warehouse?       @relation("WarehouseManager")
  qualityInspections QualityInspection[] @relation("QualityInspector")
  apiKeys            ApiKey[]            @relation("UserApiKeys")
  carbonProjects     CarbonProject[]     @relation("UserCarbonProjects")
  // ─── Support Tickets + Quotes ───
  supportTicketsCreated  SupportTicket[]    @relation("SupportTicketCreator")
  supportTicketsAssigned SupportTicket[]    @relation("SupportTicketAssignee")
  ticketReplies          SupportTicketReply[] @relation("TicketReplyUser")
  quotesCreated          Quote[]            @relation("QuoteCreator")
}

model AgentAssignment {
  id        String   @id @default(cuid())
  agentId   String
  agent     User     @relation(fields: [agentId], references: [id])
  groupId   String
  groupType String   // FARMER_GROUP, VSLA
  assignedAt DateTime @default(now())
}

// --- GEOGRAPHIC HIERARCHY ---

model Region {
  id        String     @id @default(cuid())
  name      String
  country   String
  createdAt DateTime   @default(now())
  subRegions SubRegion[]
}

model SubRegion {
  id        String    @id @default(cuid())
  name      String
  regionId  String
  region    Region    @relation(fields: [regionId], references: [id])
  districts District[]
}

model District {
  id          String       @id @default(cuid())
  name        String
  subRegionId String
  subRegion   SubRegion    @relation(fields: [subRegionId], references: [id])
  counties    County[]
}

model County {
  id          String     @id @default(cuid())
  name        String
  districtId  String
  district    District   @relation(fields: [districtId], references: [id])
  subCounties SubCounty[]
}

model SubCounty {
  id        String    @id @default(cuid())
  name      String
  countyId  String
  county    County    @relation(fields: [countyId], references: [id])
  parishes  Parish[]
}

model Parish {
  id          String     @id @default(cuid())
  name        String
  subCountyId String
  subCounty   SubCounty  @relation(fields: [subCountyId], references: [id])
  villages    Village[]
}

model Village {
  id        String   @id @default(cuid())
  name      String
  parishId  String
  parish    Parish   @relation(fields: [parishId], references: [id])
  farmers   FarmerProfile[]
}

// --- COOPERATIVES & FARMER GROUPS ---

model Company {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  type        String?  // Cooperative, Agribusiness, etc.
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  // ─── Cooperative Extension (from Excel spec) ───
  cooperativeCode String?
  dateOfFormation DateTime?
  services    String?  // JSON array: ["fertilizer","harvester","soil preparation","seeds","plant protection","compost"]
  allowFarmerSell Boolean @default(false) // Allow Farmer to Sell their Produce
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmerGroups FarmerGroup[]
}

model FarmerGroup {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  name        String
  contactPerson String?
  location    String?
  isVsla      Boolean  @default(false)
  vslaSettings Json?    // shareValue, loanRate, maxLoanAmount, fines, welfare
  isActive    Boolean  @default(true)

  // ─── EKIBBO Group Extensions (nullable) ───
  coordinatorGender String?  // Male, Female
  coordinatorAge    Int?     // age of coordinator
  collectionDay     String?  // Monday, Tuesday, etc.
  collectionCenter  String?  // name of collection center
  youthCount        Int?     // number of youth in group

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmers    FarmerProfile[]
  vslaGroups VslaGroup[]
}

// --- FARMER PROFILING ---

model FarmerProfile {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  groupId         String?
  group           FarmerGroup? @relation(fields: [groupId], references: [id])
  farmerCode      String?  @unique
  firstName       String
  lastName        String
  phone           String
  gender          String?  // Male, Female, Other
  dateOfBirth     DateTime?
  education       String?  // Primary, Secondary, UG, PG, Other
  maritalStatus   String?
  nationalIdType  String?  // National ID, Driving License, Passport
  nationalIdNo    String?
  photoUrl        String?
  isCertified     Boolean  @default(false)
  certificationType String?  // Individual, Group
  memberType      String   // General, Commercial
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE

  // ─── Enrollment (from Excel: Farmer Registration section) ───
  enrollmentDate  DateTime @default(now())
  enrollmentPlace String?  // At Farmer Place / At Cooperative / At Farmer Organization / At Warehouse
  icsYear         String?  // Year of ICS (show when isCertified = true)
  farmerRegistrationUnder String?  // Agri / Aqua / other registration category
  cooperativeId   String?  // linked cooperative (for FO users)

  // ─── ID Proof ───
  idProofPhotoUrl String?
  guardianName    String?
  email           String?

  // ─── Location (from Excel: Contact Information section) ───
  villageId       String?
  village         Village? @relation(fields: [villageId], references: [id])
  gpsLatitude     Float?
  gpsLongitude    Float?
  country         String?  // Uganda, Ghana, Kenya
  province        String?  // Region/Province
  district        String?
  commune         String?  // Sub-county / Constituency
  villageName     String?  // Village name (free text if no geo hierarchy)
  zipCode         String?

  // ─── Family (from Excel: Family Information section) ───
  familyMembers   Int?
  childrenUnder18 Int?
  schoolGoingChildren Int?
  spouseName      String?
  childrenMaleUnder18  Int?
  childrenFemaleUnder18 Int?
  schoolGoingMale   Int?
  schoolGoingFemale Int?

  // ─── Assets (from Excel: Asset Information section) ───
  housingOwnership String?  // Owned, Rent, Lease
  houseType        String?  // Brick house, Wooden house, Hut, Other
  consumerElectronics String?  // JSON: ["TV","Washing Machine","Air Conditioner","Fridge"]
  vehicle          String?  // JSON: ["Bike","Car","Boat"]

  // ─── Finance (from Excel: Finance Information — multiple bank accounts) ───
  bankName        String?
  bankAccountNo   String?
  bankBranch      String?
  bankAccounts    String?  // JSON array: [{accountType, accountNo, bankName, branch, sortCode}]
  loanTakenLastYear Boolean @default(false)
  loanTakenFrom   String?  // Bank, Relative, Friend, Farming contract, Other
  loanAmount      Float?
  loanPurpose     String?
  loanInterestPct Float?
  loanInterestPeriod String?  // Monthly, Yearly
  loanHasSecurity Boolean  @default(false)
  loanRepaymentAmount Float?
  loanRepaymentDate DateTime?

  // ─── Insurance (from Excel: Insurance Information — multiple types) ───
  insuranceData   String?  // JSON: { life: {provider,amount,enrolledDate,endDate}, health: {...}, crop: {...}, social: {...}, other: "..." }

  // ─── Farm Equipment (from Excel: Farm Equipment — multiple items) ───
  farmEquipment   String?  // JSON: [{item, count}]

  // ─── Farm ───
  farmSize        Float?   // hectares
  farmOwnership   String?  // Owned, Rent, Lease
  mainCrops       String?  // JSON array of crop names
  livestockTypes  String?  // JSON array

  // ─── EKIBBO Farmer Extensions (nullable) ───
  shadeTreeVarieties String?  // JSON: [{variety: "Banana", count: 5}, {variety: " Albizia", count: 3}]

  // ─── EKIBBO Real Data Import (from CSV — 1985 farmers) ───
  gpsAltitude          Float?
  monthlyHouseholdIncome Float?
  annualHouseholdIncome Float?
  monthlyFarmIncome    Float?
  annualFarmIncome     Float?
  primaryIncomeSource  String?
  secondaryIncomeSource String?
  extensionOfficer     String?
  orgMembership        String?
  orgNames             String?
  livingConditions     String?
  fuelType             String?
  fuelCostMonthly      Float?
  mealsPerDay          String?
  dailyCostOfLiving    String?
  hasUnusedLand        Boolean?
  unusedLandSize       Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  children        ChildProfile[]
  farms           FarmLand[]
  creditScores    CreditScore[]
  savings         VslaSaving[]
  vslaLoans       VslaLoan[]
  vslaAttendance  VslaAttendance[]
  trainings       TrainingAttendance[]
  purchases       Purchase[]
  sales           Sale[]     @relation("FarmerSales")
  cropProductions CropProduction[]
  farmerBankAccounts FarmerBankAccount[]
  farmerInsurances   FarmerInsurance[]
  farmerAnimals      FarmerAnimalHusbandry[]
  farmerEquipment    FarmerFarmEquipment[]
  vslaMemberships VslaMember[]
  farmVisits      FarmVisit[]      @relation("FarmerVisits")
  impactAssessments ImpactAssessment[] @relation("FarmerImpact")
  eudrCompliances EudrCompliance[]  @relation("FarmerEudr")
  cbamReports     CbamReport[]      @relation("FarmerCbam")
  rainforestCerts RainforestCertification[] @relation("FarmerRainforest")
  globalGapCerts  GlobalGapCertification[] @relation("FarmerGlobalGap")
  produceIntakes        ProduceIntake[]        @relation("FarmerIntake")
  cooperativePayments   CooperativePayment[]    @relation("FarmerCoopPayment")
  productBatches       ProductBatch[]         @relation("FarmerBatches")
  farmPassport         FarmPassport?          @relation("FarmerPassport")
  plots                Plot[]                 @relation("FarmerPlots")
  ccrpEnrollments      CcrpEnrollment[]        @relation("FarmerCcrpEnrollments")
  // ─── Impact Engine (6-week sprint) ───
  impactBaseline       ImpactBaseline?         @relation("FarmerImpactBaseline")
  impactEvents         ImpactEvent[]           @relation("FarmerImpactEvents")
  impactKpiSnapshots   ImpactKpiSnapshot[]     @relation("FarmerImpactKpiSnapshots")
  practiceAdoptions    PracticeAdoption[]      @relation("FarmerPracticeAdoptions")
  climateResilienceScores ClimateResilienceScore[] @relation("FarmerClimateResilienceScores")

  // ─── EKIBBO: Ledger + Input Distribution + Crop Insurance ───
  ledgerEntries       FarmerLedgerEntry[]
  inputDistributions  InputDistribution[]
  cropInsurances      CropInsurance[]
  // ─── Next of Kin (required for NSSF) ───
  nextOfKinName     String?
  nextOfKinPhone    String?
  nextOfKinRelation String?
  // ─── NSSF Voluntary Savings ───
  // NSSF fields are ON the farmer profile (not a separate registration module).
  // Field officers register farmers normally, then enroll them in NSSF by
  // filling in these fields. Nullable so non-NSSF tenants (like EKIBBO) are unaffected.
  nssfNationalId      String?   // National ID number (required for NSSF KYC)
  nssfNumber          String?   // NSSF member number (assigned by NSSF)
  nssfActivationStatus String?  // null = not enrolled, PENDING, VERIFIED, ACTIVATED, REJECTED
  nssfEnrolledAt      DateTime? // When the farmer was enrolled in NSSF
  nssfActivatedAt     DateTime? // When NSSF confirmed the activation
  nssfValueChain      String?   // Coffee, Cocoa, Vanilla, etc. (for NSSF reporting)
  // Relations
  nssfRegistration    NssfRegistration? @relation("NssfRegistrationFarmer")
  nssfContributions   NssfContribution[] @relation("NssfContributionFarmer")

  @@index([tenantId])
  @@index([groupId])
  @@index([status])
  @@index([createdAt])
  @@index([firstName])
  @@index([lastName])
  @@index([phone])
  @@index([district])
  @@index([gender])
}

model ChildProfile {
  id          String   @id @default(cuid())
  farmerId    String
  farmer      FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  gender      String?
  dateOfBirth DateTime?
  schoolName  String?
  schoolId    String?
  createdAt   DateTime @default(now())
}

model FarmLand {
  id          String   @id @default(cuid())
  farmerId    String
  farmer      FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name        String
  sizeHectares Float?
  latitude    Float?
  longitude   Float?
  landOwnership String?
  waterSource String?
  soilFertility String?
  isActive    Boolean  @default(true)

  // ─── Farm Land Creation fields (from Excel: 26 new fields) ───
  landSurveyNo    String?
  approachRoad    String?  // JSON: ["close main road","inner field","close main canal"]
  landTopology    String?  // Valley, Plains, Plateaus
  landGradient    String?  // JSON: ["Up Land","Low Land"]
  landDocumentUrl String?
  powerSource     String?  // Solar, Electricity, Fuel
  farmPhotoUrl    String?
  // Soil & Irrigation
  irrigationSource String? // JSON: ["Rainfed","Irrigated"]
  irrigationType   String? // Drip, Canal, Others
  // Labor
  fullTimeWorkers  Int?
  partTimeWorkers  Int?
  seasonalWorkers  Int?
  familyWorkers    Int?
  // Conversion Info (organic)
  lastChemicalApplicationDate DateTime?
  conventionalLands String?
  fallowPastureLand String?
  conventionalCrops String?
  estYieldKg       Float?
  // Certification conversion
  certType         String?  // NPOP, NOP
  conversionStatus String?  // IC-1, IC-2, IC-3, Organic, SRP
  conversionDate   DateTime?
  inspectorName    String?
  conversionQualified Boolean?
  conversionRemarks String?
  // Soil Analysis (kept for backward compatibility with existing data)
  soilCollectionDate DateTime?
  soilLabTestingDate DateTime?
  soilResultDate   DateTime?
  soilReportUrl    String?
  soilSamplesInfo  String?  // text: no of samples + area
  soilCriteria     String?  // JSON: [{criteria: "pH", value: "6.5"}, {criteria: "N", value: "120ppm"}]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cultivations Cultivation[]
  polygonPoints FarmPolygon[]
  soilAnalyses  SoilAnalysis[]

  @@index([farmerId])
  @@index([createdAt])
  @@index([name])
}

model SoilAnalysis {
  id              String   @id @default(cuid())
  farmId          String
  farm            FarmLand @relation(fields: [farmId], references: [id], onDelete: Cascade)
  collectionDate  DateTime?
  labTestingDate  DateTime?
  resultDate      DateTime?
  reportUrl       String?
  samplesInfo     String?  // no of samples collected and area
  criteria        String   // pH, Sulphur(S), Nitrogen(N), Phosphorus(P), Potassium(K), etc.
  criteriaValue   String?  // value with UOM (e.g. "6.5", "120ppm")
  minValue        String?  // min permissible value with UOM
  maxValue        String?  // max permissible value with UOM
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([farmId])
}

model Cultivation {
  id              String   @id @default(cuid())
  farmId          String
  farm            FarmLand @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropName        String
  variety         String?
  season          String?
  sowingDate      DateTime?
  estimatedYield  Float?
  actualYield     Float?
  status          String   @default("ACTIVE")

  // ─── Cultivation Creation fields (from Excel: 13 new fields) ───
  cropCategory    String?  // Main Crop, Inter Crop, Border Crop
  cultivationAreaHa Float? // hectares (may differ from farm size — partial planting)
  cropCalendarId  String?  // linked crop calendar
  cultivationGeoJson String? // GeoJSON polygon for the cultivation area
  photoUrl        String?
  // Seed Information
  seedSource      String?  // Seed Company, Agent, Self-save
  isSeedTreated   Boolean  @default(false)
  seedType        String?  // Certified 1, Certified 2, Self-save, Other
  seedQuantity    Float?   // kg
  seedPrice       Float?   // per kg
  seedCost        Float?   // auto-calc: quantity × price
  // Sowing
  sowingType      String?  // Row sowing, Hand sowing, Drone sowing, Transplanting, Re-planting
  sowingChargesBy String?  // hour, hectare
  sowingCharges   Float?   // per unit
  sowingCost      Float?   // auto-calc: area × charges (or hours × charges)

  // ─── EKIBBO Bamboo Tracking (nullable) ───
  bambooVariety   String?  // strictus, Vulgaris green, Asper
  seedlingCount   Int?     // number of seedlings per variety

  // Relations
  stageEvents     CropStageEvent[] @relation("CultivationStageEvents")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([farmId])
  @@index([cropName])
  @@index([status])
  @@index([createdAt])
}

// --- CROP PRODUCTION (EKIBBO real data — crop-specific per farmer) ---

model CropProduction {
  id                      String   @id @default(cuid())
  farmerId                String
  farmer                  FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropName                String   // Coffee, Cocoa, Avocado, Vanilla, Cassava, etc.
  variety                 String?
  landPercentage          Float?   // % of land dedicated to this crop
  yearsInFarming          Int?
  treeCount               Int?     // productive trees
  yieldPerTreeKg          Float?   // estimated yield kg per tree
  majorBuyers             String?
  pricePerKg              Float?
  priceDetermination      String?  // how prices are determined
  paymentMethod           String?  // cash, mobile money, bank, etc.
  incomeContributionPct   Float?   // % of household income from this crop
