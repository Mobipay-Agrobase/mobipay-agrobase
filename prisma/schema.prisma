// --- PURCHASES & CONSIGNMENTS ---

model Purchase {
  id          String   @id @default(cuid())
  groupId     String?
  farmerId    String?
  farmer      FarmerProfile? @relation(fields: [farmerId], references: [id])
  commodity   String
  variety     String?
  quantity    String
  unitPrice   Float?
  totalAmount Float?
  status      String   @default("PENDING") // PENDING, REVIEWED, APPROVED, PAID
  initiatedBy String?
  reviewedBy  String?
  approvedBy  String?

  // ─── EKIBBO Enhanced Purchase Workflow (nullable — no impact on other tenants) ───
  tenantId        String?   // links to tenant for EKIBBO purchases
  moistureReading Float?    // moisture percentage (coffee/cocoa)
  moistureDeduction Float?  // kg deducted due to high moisture (above threshold)
  moistureThreshold Float?  // moisture % threshold used at purchase time (default 13)
  moisturePhotoUrl String?  // URL of moisture meter photo
  defectCount     Int?      // number of defects/blacks (coffee quality)
  qualityDeduction Float?   // weight deducted due to quality (kg)
  netWeight       Float?    // quantity - qualityDeduction
  dailyPrice      Float?    // price per kg for this purchase
  loanDeduction   Float?    // amount deducted for loan repayment
  inputDeduction  Float?    // amount deducted for input repayment
  momoCharges     Float?    // mobile money withdrawal charges
  momoTax         Float?    // mobile money tax
  netPayment      Float?    // final amount paid to farmer
  loanId          String?   // linked loan for deduction
  inputDistId     String?   // linked input distribution for deduction
  approvalStatus  String?   // DRAFT, SUBMITTED, APPROVED, REJECTED
  approvedById    String?   // user who approved
  approvedAt      DateTime? // when approved
  paymentRef      String?   // mobile money transaction reference

  // Ledger entries created from this purchase
  ledgerEntries   FarmerLedgerEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- EKIBBO: Farmer Ledger Engine ---

model FarmerLedgerEntry {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  farmerId      String
  farmer        FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  type          String   // PURCHASE, SALE, LOAN_DISBURSE, LOAN_REPAY, INPUT_DIST,
                         // INPUT_REPAY, TRAINING, INSURANCE, CHARGE, PAYMENT, ADJUSTMENT
  description   String
  amount        Float    // positive = credit to farmer, negative = debit
  balanceAfter  Float?   // running balance after this entry
  referenceType String?  // "Purchase", "Sale", "Loan", "Training", etc.
  referenceId   String?  // links to the original record
  purchaseId    String?  // optional link to Purchase
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  createdBy     String?  // userId who created this entry
  approvalStatus String? // DRAFT, SUBMITTED, APPROVED, REJECTED
  approvedBy    String?  // userId who approved
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([farmerId])
  @@index([type])
  @@index([date])
}

// --- EKIBBO: Input Distribution ---

model InputDistribution {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  farmerId        String
  farmer          FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  inputType       String   // tarpaulin, fertilizer, pruning_saw, seedling
  inputName       String?  // specific name/brand
  quantity        Float
  unit            String   @default("pcs")
  unitCost        Float
  totalCost       Float    // quantity × unitCost
  paymentMode     String?  // CREDIT, CASH_FULL, CASH_PARTIAL (Ekibbo: cash in installments)
  amountPaid      Float?   // amount paid at distribution time (cash full/partial)
  balanceRemaining Float?  // outstanding balance to be repaid
  status          String   @default("DISTRIBUTED") // DISTRIBUTED, PARTIALLY_REPAID, FULLY_REPAID
  distributionDate DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([farmerId])
  @@index([status])
}

// --- EKIBBO: Crop Insurance ---

model CropInsurance {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  farmerId        String
  farmer          FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop            String   // coffee, cocoa, vanilla, etc.
  provider        String?  // insurance company name
  policyNumber    String?
  premium         Float?   // premium amount
  coverageAmount  Float?   // total coverage
  status          String   @default("ENROLLED") // ENROLLED, ACTIVE, LAPSED, PAYOUT_RECEIVED
  enrollmentDate  DateTime @default(now())
  payoutAmount    Float?   // amount received if payout
  payoutDate      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([farmerId])
  @@index([status])
}

model Consignment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  product     String
  quantity    String
  source      String?
  destination String?
  status      String   @default("DRAFT") // DRAFT, DISPATCHED, CHECKED_IN, RECEIVED, APPROVED, PAID
  totalValue  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProcessingBatch {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  batchNumber     String   @unique
  inputCommodity  String
  processType     String   // WASHING, DRYING, MILLING, ROASTING, FERMENTATION, GRADING, PACKAGING
  outputProduct   String?
  inputQuantity   Float
  inputUnit       String   @default("kg")
  outputQuantity  Float?
  outputUnit      String?
  qualityGrade    String?  // GRADE_A, GRADE_B, GRADE_C, REJECT
  qualityScore    Float?
  facility        String?
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REJECTED
  startDate       DateTime?
  endDate         DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([batchNumber])
}

// --- PAYMENTS ---

model PaymentAccount {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  accountName String
  accountType String   @default("MERCHANT")
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  paymentAccountId String?
  paymentAccount  PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  type            String   // CASUAL, BULK_PURCHASE, BULK_DISBURSEMENT, MARKETPLACE, VSLA
  recipientName   String
  recipientPhone  String
  amount          Float
  description     String?
  transactionRef  String?
  purchaseId      String?  // E2E trace: purchase this payment settles
  saleId          String?  // E2E trace: sale this payment settles
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED

  // EKIBBO: Extension officer can update farmer phone during payment
  phoneUpdateRequested Boolean @default(false)
  newPhoneNumber  String?  // new phone number requested by extension officer
  consentFormUrl  String?  // consent form attachment (required if phoneUpdateRequested = true)

  // EKIBBO: Charges and taxes visible to extension officers
  charges         Float?
  taxAmount       Float?
  netAmount       Float?   // auto-calc: amount - charges - taxAmount

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions          PaymentTransaction[]   @relation("PaymentTransactions")
}

// --- TRAINING ---

model Training {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  topic       String
  description String?
  date        DateTime
  location    String?
  trainerName String?
  createdAt   DateTime @default(now())

  // ─── Training Program Flow (CRUD + enrollment) ───
  type            String   @default("GROUP_TRAINING") // GROUP_TRAINING | FARM_VISIT | DEMO_PLOT | WORKSHOP | FIELD_DAY
  status          String   @default("SCHEDULED")      // SCHEDULED | ONGOING | COMPLETED | CANCELLED
  conductedById   String?                            // User who conducts (extension officer)
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int?
  expectedAttendees Int?
  materialsUsed   String?   // JSON array: ["Booklet", "Seed samples"]
  notes           String?
  groupId         String?   // optional: link to a FarmerGroup (group-based training)
  cohortId        String?   // optional: link to a program cohort (CCRP, SMILE, etc.)

  attendance  TrainingAttendance[]
}

model TrainingAttendance {
  id          String   @id @default(cuid())
  trainingId  String
  training    Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  farmerId    String
  farmer      FarmerProfile @relation(fields: [farmerId], references: [id])
  attended    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // ─── Enrollment flow ───
  enrolledAt       DateTime?  // when farmer was invited/enrolled
  enrollmentStatus String   @default("INVITED") // INVITED | ENROLLED | ATTENDED | ABSENT | CANCELLED
  enrolledById     String?  // who enrolled them (extension officer / agent)
  feedbackRating   Int?     // 1-5 farmer feedback
  feedbackNotes    String?
}

// --- CREDIT SCORING ---

model CreditScore {
  id              String   @id @default(cuid())
