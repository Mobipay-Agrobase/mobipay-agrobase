  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  commodity   String
  variety     String?
  grade       String?
  quantity    Float
  unitPrice   Float
  delivered   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContractMilestone {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name        String
  dueDate     DateTime
  quantity    Float?
  amount      Float?
  status      String   @default("PENDING")
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- LOGISTICS ---

model Vehicle {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation("TenantVehicles", fields: [tenantId], references: [id])
  plateNumber String   @unique
  type        String
  capacity    Float
  driverName  String?
  driverPhone String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shipments   Shipment[]
}

model Shipment {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation("TenantShipments", fields: [tenantId], references: [id])
  shipmentCode  String   @unique
  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  contractId    String?
  contract      Contract? @relation(fields: [contractId], references: [id])
  originId      String?
  destinationId String?
  status        String   @default("PLANNED")
  departureTime DateTime?
  arrivalTime   DateTime?
  driverName    String?
  driverPhone   String?
  totalWeight   Float?
  route         String?
  notes         String?
