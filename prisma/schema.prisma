  amount          Float
  items           String?
  qrCode          String?
  pinVerified     Boolean  @default(false)
  agentVerified   Boolean  @default(false)
  status          String   @default("COMPLETED")
  ipAddress       String?
  userAgent       String?
  redeemedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
}

model ResetMerchant {
  id              String   @id @default(cuid())
  merchantCode    String   @unique
  tenantId        String
  businessName    String
  ownerName       String
  phone           String
  settlement      String
  location        String?
  businessType    String
  itemsSold       String?
  momoNumber      String?
  payoutFrequency String   @default("WEEKLY")
  payoutAmount    Float    @default(0)
  lastPayoutAt    DateTime?
  status          String   @default("PENDING")
  approvedAt      DateTime?
  approvedBy      String?
