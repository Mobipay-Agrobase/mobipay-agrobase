model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  commodity   String
  grade       String?
  quantity    Float
  batchCode   String?
  createdAt   DateTime @default(now())
}

// --- PARTNER MANAGEMENT ---

model Partner {
